{
  "name": "ollama",
  "library": "ollama",
  "version": "0.1.0",
  "description": "Reference scenario for Ollama semantic conventions",
  "signals": {
    "spans": [
      {
        "name": "ollama.client.chat",
        "type": "ollama.client.chat",
        "kind": "CLIENT",
        "attributes": {
          "gen_ai.operation.name": "chat",
          "ollama.request.model": "llama3.2",
          "gen_ai.request.model": "llama3.2",
          "ollama.request.base_url": "http://127.0.0.1:11434",
          "server.address": "127.0.0.1",
          "server.port": 11434,
          "ollama.request.stream": false,
          "ollama.request.temperature": 0.7,
          "gen_ai.request.temperature": 0.7,
          "ollama.request.top_p": 0.9,
          "gen_ai.request.top_p": 0.9,
          "ollama.request.max_tokens": 256,
          "gen_ai.request.max_tokens": 256,
          "ollama.response.model": "llama3.2",
          "gen_ai.response.model": "llama3.2",
          "ollama.response.total_duration": 1500000000,
          "ollama.response.load_duration": 500000000,
          "ollama.response.prompt_eval_count": 25,
          "ollama.response.eval_count": 100,
          "gen_ai.usage.input_tokens": 25,
          "gen_ai.usage.output_tokens": 100,
          "gen_ai.response.finish_reason": "stop"
        }
      },
      {
        "name": "ollama.client.generate",
        "type": "ollama.client.generate",
        "kind": "CLIENT",
        "attributes": {
          "gen_ai.operation.name": "generate",
          "ollama.request.model": "mistral",
          "gen_ai.request.model": "mistral",
          "ollama.request.base_url": "http://127.0.0.1:11434",
          "server.address": "127.0.0.1",
          "server.port": 11434,
          "ollama.request.stream": false,
          "ollama.request.temperature": 0.3,
          "gen_ai.request.temperature": 0.3,
          "ollama.request.max_tokens": 100,
          "gen_ai.request.max_tokens": 100,
          "ollama.response.model": "mistral",
          "gen_ai.response.model": "mistral",
          "ollama.response.total_duration": 2000000000,
          "ollama.response.load_duration": 600000000,
          "ollama.response.prompt_eval_count": 10,
          "ollama.response.eval_count": 50,
          "gen_ai.usage.input_tokens": 10,
          "gen_ai.usage.output_tokens": 50,
          "gen_ai.response.finish_reason": "stop"
        }
      }
    ],
    "metrics": [],
    "events": []
  },
  "attribute_keys": {
    "ollama.request.model": {
      "type": "string",
      "brief": "The name of the Ollama model being used.",
      "examples": ["llama3.2", "mistral"]
    },
    "ollama.request.base_url": {
      "type": "string",
      "brief": "The base URL of the Ollama API endpoint.",
      "examples": ["http://localhost:11434"]
    },
    "ollama.request.stream": {
      "type": "boolean",
      "brief": "Indicates whether the request was made in streaming mode."
    },
    "ollama.request.temperature": {
      "type": "double",
      "brief": "The temperature setting for the request."
    },
    "ollama.request.max_tokens": {
      "type": "int",
      "brief": "The maximum number of tokens to generate."
    },
    "ollama.response.model": {
      "type": "string",
      "brief": "The name of the model that generated the response."
    },
    "ollama.response.total_duration": {
      "type": "int",
      "brief": "The total time in nanoseconds the model took to generate the response."
    },
    "ollama.response.eval_count": {
      "type": "int",
      "brief": "The number of tokens generated by the model."
    }
  }
}
